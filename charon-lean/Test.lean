import Charon

open Charon

/-! Deserializes the postcard files generated by the charon test suite, and checks that our
pretty-printer agrees with `charon pretty-print`. Mirrors the charon-ml tests. -/

/-- Test files for which our pretty-printer is known to differ from charon's. -/
def knownPrintDiffs : List String := [
  -- Printing partially-monomorphized tuples requires substituting their generics into the types of
  -- their fields (see `Ty::as_tuple_fields`), which we don't implement.
  "partial-monomorphization/mono-mut-tuple.llbc.postcard"
]

def runCmd (cmd : String) (args : Array String) (allowFailure := false) : IO String := do
  let out ← IO.Process.output { cmd, args }
  if out.exitCode != 0 && !allowFailure then
    throw <| IO.userError s!"`{cmd} {" ".intercalate args.toList}` failed:\n{out.stderr}"
  return out.stdout

def unifiedDiff (rust lean : String) : IO String :=
  IO.FS.withTempDir fun dir => do
    IO.FS.writeFile (dir / "rust") rust
    IO.FS.writeFile (dir / "lean") lean
    runCmd "diff" #["-u", (dir / "rust").toString, (dir / "lean").toString] (allowFailure := true)

def main : IO UInt32 := do
  -- Same environment variables and defaults as the charon-ml tests.
  let dir : System.FilePath := (← IO.getEnv "CHARON_TESTS_DIR").getD "../charon/tests/ui"
  let charon := (← IO.getEnv "CHARON_BIN").getD "../bin/charon"
  let files ← dir.walkDir
  let files := files.qsort (·.toString < ·.toString)
  let postcardFiles := files.filter (·.toString.endsWith ".postcard")
  if postcardFiles.isEmpty then
    IO.eprintln s!"error: no postcard files found in {dir}; run the charon test suite first"
    return 1
  let mut failures := 0
  let mut time := 0
  for file in postcardFiles do
    let start ← IO.monoMsNow
    match CrateData.ofPostcardBytes (← IO.FS.readBinFile file) with
    | .error e =>
      IO.eprintln s!"error: failed to deserialize {file}: {e}"
      failures := failures + 1
    | .ok data =>
      time := time + ((← IO.monoMsNow) - start)
      let rust := (← runCmd charon #["pretty-print", "--format", "postcard", file.toString]).trimAsciiEnd.toString ++ "\n"
      let lean := data.translated.toPrettyString.trimAsciiEnd.toString ++ "\n"
      let known := knownPrintDiffs.any (file.toString.endsWith ·)
      if rust != lean && !known then
        IO.eprintln s!"error: the output differs from `{charon} pretty-print` for {file}:\n\
          {← unifiedDiff rust lean}"
        failures := failures + 1
      else if rust == lean && known then
        IO.eprintln s!"error: {file} is listed in `knownPrintDiffs` but now prints correctly"
        failures := failures + 1
  IO.println s!"Checked {postcardFiles.size} files; deserializing them took {time}ms."
  -- Feeding a JSON file to the postcard deserializer gives a helpful error.
  if let some json := files.find? (·.toString.endsWith ".llbc") then
    match CrateData.ofPostcardBytes (← IO.FS.readBinFile json) with
    | .ok _ =>
      IO.eprintln s!"error: the postcard deserializer accepted the JSON file {json}"
      failures := failures + 1
    | .error e =>
      unless (e.splitOn "looks like JSON").length > 1 do
        IO.eprintln s!"error: wrong error when deserializing the JSON file {json}: {e}"
        failures := failures + 1
  return if failures == 0 then 0 else 1
