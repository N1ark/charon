inductive WithRetag where
  | No
  | Yes
  deriving Inhabited

/-- Unary operation -/
inductive UnOp where
  | Not
  /-- This can overflow, for `-i::MIN`. -/
  | Neg (_0 : OverflowMode)
  /-- Casts are rvalues in MIR, but we treat them as unops. -/
  | Cast (_0 : CastKind)
  deriving Inhabited

/-- Nullary operation -/
inductive NullOp where
  /-- Returns `true` during const evaluation, and `krate.runtime_checks.ub_checks` at runtime. -/
  | UbChecks
  | OverflowChecks
  | ContractChecks
  deriving Inhabited

inductive BorrowKind where
  | Shared
  | Mut
  /--
  See <https://doc.rust-lang.org/beta/nightly-rustc/rustc_middle/mir/enum.MutBorrowKind.html#variant.TwoPhaseBorrow>
  and <https://rustc-dev-guide.rust-lang.org/borrow_check/two_phase_borrows.html>
  -/
  | TwoPhaseMut
  /--
  Those are typically introduced when using guards in matches, to make sure guards don't
  change the variant of an enum value while me match over it.

  See <https://doc.rust-lang.org/beta/nightly-rustc/rustc_middle/mir/enum.FakeBorrowKind.html#variant.Shallow>.
  -/
  | Shallow
  /--
  Data must be immutable but not aliasable. In other words you can't mutate the data but you
  can mutate *through it*, e.g. if it points to a `&mut T`. This is only used in closure
  captures, e.g.
  ```rust,ignore
  let mut z = 3;
  let x: &mut isize = &mut z;
  let y = || *x += 5;
  ```
  Here the captured variable can't be `&mut &mut x` since the `x` binding is not mutable, yet
  we must be able to mutate what it points to.

  See <https://doc.rust-lang.org/beta/nightly-rustc/rustc_middle/mir/enum.MutBorrowKind.html#variant.ClosureCapture>.
  -/
  | UniqueImmutable
  deriving Inhabited

/-- An expression that evaluates to a value. This is the RHS of an assignment. -/
inductive Rvalue where
  /-- Lifts an operand as an rvalue. -/
  | Use (_0 : Operand) (_1 : WithRetag)
  /--
  Takes a reference to the given place.
  The `Operand` refers to the init value of the metadata, it is `()` if no metadata
  -/
  | Ref (place : Place) (kind : BorrowKind) (ptr_metadata : Operand)
  /--
  Takes a raw pointer with the given mutability to the given place. This is generated by
  pointer casts like `&v as *const _` or raw borrow expressions like `&raw const v.`
  Like `Ref`, the `Operand` refers to the init value of the metadata, it is `()` if no metadata.
  -/
  | RawPtr (place : Place) (kind : RefKind) (ptr_metadata : Operand)
  /-- Binary operations. -/
  | BinaryOp (_0 : BinOp) (_1 : Operand) (_2 : Operand)
  /-- Unary operation (e.g. not, neg) -/
  | UnaryOp (_0 : UnOp) (_1 : Operand)
  /-- An operation with no inputs. -/
  | NullaryOp (_0 : NullOp)
  /--
  Discriminant read. Reads the discriminant value of an enum. The place must have the type of
  an enum. The discriminant in question is the one in the `discriminant` field of the
  corresponding `Variant`. This can be different than the value stored in memory (called
  `tag`); that one is described by [`Discriminator`] and [`VariantLayout::tagger`].
  -/
  | Discriminant (_0 : Place)
  /--
  Creates an aggregate value, like a tuple, a struct or an enum:
  ```text
  l = List::Cons { value:x, tail:tl };
  ```
  Note that in some MIR passes (like optimized MIR), aggregate values are
  decomposed, like below:
  ```text
  (l as List::Cons).value = x;
  (l as List::Cons).tail = tl;
  ```
  Because we may want to plug our translation mechanism at various
  places, we need to take both into accounts in the translation and in
  our semantics. Aggregate value initialization is easy, you might want
  to have a look at expansion of `Bottom` values for explanations about the
  other case.

  Remark: in case of closures, the aggregated value groups the closure id
  together with its state.
  -/
  | Aggregate (_0 : AggregateKind) (_1 : Array Operand)
  /--
  `Repeat(x, n)` creates an array containing `n` copies of `x`.

  Fields:
  - `operand`
  - `count`
  - `elem_is_copy`: Proof that the element type is `Copy`.
  - `elem_is_sized`: Proof that the element type is `Sized`; absent with `--hide-marker-traits`.
  -/
  | Repeat (operand : Operand) (count : ConstantExpr) (elem_is_copy : TraitRef) (elem_is_sized : Option TraitRef)
  deriving Inhabited

/-- Statements that only affect borrow-checking. They are no-ops at runtime. -/
inductive BorrowckStatement where
  /-- Acts like a read of the place. -/
  | FakeRead (_0 : Place)
  /--
  Relate the type of a place to the provided type. For example, `let x: Self = value`
  produces `SetType` for `x` and `Self`.
  -/
  | SetType (place : Place) (ty : Ty) (variance : Variance)
  /--
  Require a type to outlive a region. For example, the `'a` bound in
  `let x: impl Copy + 'a = value` produces `SetOutlives(typeof(x), 'a)`.
  -/
  | SetOutlives (_0 : Ty) (_1 : Region)
  /--
  Require a trait predicate to hold. For example, the `Copy` bound in
  `let x: impl Copy = value` produces `PredicateHolds(typeof(x): Copy)`.
  -/
  | PredicateHolds (_0 : PolyTraitRef)
  deriving Inhabited

inductive Ullbc.StatementKind where
  | Assign (_0 : Place) (_1 : Rvalue)
  /-- A call. For now, we don't support dynamic calls (i.e. to a function pointer in memory). -/
  | SetDiscriminant (_0 : Place) (_1 : VariantId)
  /--
  Indicates that this local should be allocated; if it is already allocated, this frees
  the local and re-allocates it. The arguments do not receive a `StorageLive`. We ensure in
  the micro-pass `insert_storage_statements` that all other locals have a `StorageLive`
  associated with them.
  -/
  | StorageLive (_0 : LocalId)
  /--
  Deallocates the given local; if it is already deallocated, this is
  a no-op. Not all local deallocations are explicit: if a non-return local is still live at
  function end (return or unwind), it is implicitly deallocated.
  If `--deallocate-all-locals` is set, all local deallocations are made explicit.
  -/
  | StorageDead (_0 : LocalId)
  /--
  A place is mentioned, but not accessed. The place itself must still be valid though, so
  this statement is not a no-op: it can trigger UB if the place's projections are not valid
  (e.g. because they go out of bounds).
  -/
  | PlaceMention (_0 : Place)
  /-- Statements that only affect borrow-checking. -/
  | Borrowck (_0 : BorrowckStatement)
  /--
  A non-diverging runtime check for a condition. This can be either:
  - Emitted for inlined "assumes" (which cause UB on failure)
  - Reconstructed from `if b { panic() }` if `--reconstruct-asserts` is set.

  This statement comes with the effect that happens when the check fails
  (rather than representing it as an unwinding edge).
  -/
  | Assert (assert : Assert) (on_failure : AbortKind)
  /-- Does nothing. Useful for passes. -/
  | Nop
  deriving Inhabited

/-- A statement. -/
structure Ullbc.Statement where
  span : Span
  kind : Ullbc.StatementKind
  /-- Comments that precede this statement. -/
  comments_before : Array String
  deriving Inhabited

/-- The value inspected by a switch. Must be of integer, bool or char type. -/
inductive SwitchScrutinee where
  /-- Inspect the value produced by an operand. -/
  | Value (_0 : Operand)
  /-- Inspect the discriminant of an enum place. -/
  | Discriminant (_0 : Place)
  deriving Inhabited

/-- A branching operation. -/
structure SwitchData where
  /-- The value to branch over. -/
  scrutinee : SwitchScrutinee
  /--
  Which branch to take for each value of the scrutinee. Several values may point to the same
  branch, and not all values may be accounted for.

  If the scrutinee is an operand, the constant expressions are literal values. If the
  scrutinee is a discriminant read, the expressions are of the form
  `ConstantExprKind::Discriminant`.
  -/
  branches : Array (ConstantExpr × BranchId)
  /--
  Branch to use if the scrutinee didn't match any of the values above. `None` if the set of
  branch values is known to be exhaustive.
  -/
  fallback : Option BranchId
  deriving Inhabited

/-- Contents of an inline assembly block. -/
structure InlineAsm where
  /-- Whether this is an `asm!` or `naked_asm!` assembly block. -/
  kind : AsmKind
  /-- The assembly code, parsed into a series of text fragments interspersed with placeholders. -/
  template : Array AsmTemplatePiece
  /--
  Input/outputs of the asm block. Not all of them may be referred to by placeholders, e.g.
  explicit register operands may not.
  -/
  operands : IndexVec AsmOperandId AsmOperand
  /-- The flags set in `options(...)`. -/
  options : AsmOptions
  deriving Inhabited

/--
A `Drop` statement/terminator can mean two things, depending on what MIR phase we retrieved
from rustc: it could be a real drop, or it could be a "conditional drop", which is where drop
may happen depending on whether the borrow-checker determines a drop is needed.
-/
inductive DropKind where
  /--
  A real drop. This calls `<T as Destruct>::drop_glue(&mut place)` and marks the
  place as moved-out-of. Use `--desugar-drops` to transform all such drops to an actual
  function call.

  The `drop_glue` method is added by Charon to the `Destruct` trait to make it possible
  to track drop code in polymorphic code. It contains the same code as the
  `core::ptr::drop_glue<T>` builtin would.

  Drop are precise in MIR `elaborated` and `optimized`.
  -/
  | Precise
  /--
  A conditional drop, which may or may not end up running drop code depending on the code
  path that led to it. A conditional drop may also become a partial drop (dropping only the
  subplaces that haven't been moved out of), may be conditional on the code path that led to
  it, or become an async drop. The exact semantics are left intentionally unspecified by
  rustc developers. To elaborate such drops into precise drops, pass `--precise-drops` to
  Charon.

  A conditional drop may also be passed an unaligned place when dropping fields of packed
  structs. Such a thing is UB for a precise drop.

  Drop are conditional in MIR `built` and `promoted`.
  -/
  | Conditional
  deriving Inhabited

/--
A function operand is used in function calls.
It either designates a top-level function, or a place in case
we are using function pointers stored in local variables.
-/
inductive FnOperand where
  /-- Regular case: call to a top-level function, trait method, etc. -/
  | Regular (_0 : FnPtr)
  /-- Call through a function pointer, instantiated with the given regions. -/
  | Dynamic (_0 : Operand) (_1 : RegionArgs)
  deriving Inhabited

/--
Whether we statically know something about the safety of this call, that takes
precedence over the safety of the callee's signature.
-/
inductive CallSafety where
  /-- As safe as the callee's signature. -/
  | Inherit
  /--
  Safe despite an unsafe signature: desugared drops, and calls to safe `#[target_feature]` functions
  from contexts that enable the required features.
  -/
  | Safe
  /--
  Unsafe despite a safe signature: calls to `#[target_feature]` functions from contexts
  that don't enable the required features, and explicit calls to `Drop` methods.
  -/
  | Unsafe
  deriving Inhabited

structure Call where
  func : FnOperand
  args : Array Operand
  safety : CallSafety
  deriving Inhabited

inductive TerminatorKind where
  | Goto (target : Ullbc.BlockId)
  | Switch (data : SwitchData) (branches : IndexVec BranchId Ullbc.BlockId)
  | Call (call : Call) (dest : Place) (target : Ullbc.BlockId) (on_unwind : Ullbc.BlockId)
  /--
  Drop the value at the given place.

  Depending on `DropKind`, this may be a real call to `drop_glue`, or a conditional call
  that should only happen if the place has not been moved out of. See the docs of `DropKind`
  for more details; to get precise drops use `--precise-drops`.

  Fields:
  - `kind`
  - `place`
  - `fn_ptr`: Reference to the `drop_glue` code to call on drop.
  - `target`
  - `on_unwind`
  -/
  | Drop (kind : DropKind) (place : Place) (fn_ptr : FnPtr) (target : Ullbc.BlockId) (on_unwind : Ullbc.BlockId)
  /--
  Deallocate a `Box` whose pointee has already been moved out/dropped.

  Resugared when it appears in elaborated/optimized MIR, if `--treat-box-as-builtin` is set
  and `--desugar-drops` isn't.
  -/
  | DropEmptyBox (place : Place) (target : Ullbc.BlockId) (on_unwind : Ullbc.BlockId)
  /--
  An inline assembly block.

  Fields:
  - `asm`
  - `fallthrough`: Next block if the control-flow continues without jumping. Absent for `naked_asm!` and `noreturn`.
  - `labels`: Targets of [`AsmOperand::Label`] operands.
  - `on_unwind`: Action to be taken if the inline assembly unwinds.
  -/
  | InlineAsm (asm : InlineAsm) (fallthrough : Option Ullbc.BlockId) (labels : IndexVec BranchId Ullbc.BlockId) (on_unwind : Ullbc.BlockId)
  /--
  Assert that the given condition holds, and if not, unwind to the given block. This is used for
  bounds checks, overflow checks, etc.
  -/
  | Assert (assert : Assert) (target : Ullbc.BlockId) (on_unwind : Ullbc.BlockId)
  /--
  Call to a built-in panicking function. Only if `--reconstruct-panic-calls` is passed.

  Fields:
  - `name`: The name of the function that was called.
  - `on_unwind`
  -/
  | Panic (name : Name) (on_unwind : Ullbc.BlockId)
  /-- Unwinding must stop for ABI reasons or because cleanup code panicked again. -/
  | UnwindTerminate
  /-- Unwind out of the current function into its caller. -/
  | UnwindResume
  | Return
  /-- Reaching this point is undefined behavior in the Rust abstract machine. -/
  | UndefinedBehavior
  deriving Inhabited

/-- A terminator: instruction to execute at the end of a block, which may jump to other blocks. -/
structure Terminator where
  span : Span
  kind : TerminatorKind
  /-- Comments that precede this terminator. -/
  comments_before : Array String
  deriving Inhabited

/--
A "basic block", which contains a linear sequence of statements, followed by a terminator, which
is where non-linear control-flow happens.
-/
structure Ullbc.BlockData where
  statements : Array Ullbc.Statement
  terminator : Terminator
  kind : UnwindKind
  deriving Inhabited

structure StatementId where
  index : Nat
  deriving Inhabited, Ord

instance : Idx StatementId := ⟨StatementId.index, StatementId.mk⟩

structure Llbc.BlockId where
  index : Nat
  deriving Inhabited, Ord

instance : Idx Llbc.BlockId := ⟨Llbc.BlockId.index, Llbc.BlockId.mk⟩

mutual

/-- A sequence of statements. -/
structure Llbc.Block where
  span : Span
  /-- An integer uniquely identifying this block. -/
  id : Llbc.BlockId
  statements : Array Llbc.Statement

/-- A statement, which can contain nested statements inside loops or switchers. -/
structure Llbc.Statement where
  span : Span
  /-- An integer uniquely identifying this statement. -/
  id : StatementId
  kind : Llbc.StatementKind
  /-- Comments that precede this statement. -/
  comments_before : Array String

inductive Llbc.StatementKind where
  /--
  Assigns an `Rvalue` to a `Place`. e.g. `let y = x;` could become
  `y := move x` which is represented as `Assign(y, Rvalue::Use(Operand::Move(x)))`.
  -/
  | Assign (_0 : Place) (_1 : Rvalue)
  /-- Not used today because we take MIR built. -/
  | SetDiscriminant (_0 : Place) (_1 : VariantId)
  /--
  Indicates that this local should be allocated; if it is already allocated, this frees
  the local and re-allocates it. The arguments do not receive a `StorageLive`. We ensure in
  the micro-pass `insert_storage_statements` that all other locals have a `StorageLive`
  associated with them.
  -/
  | StorageLive (_0 : LocalId)
  /--
  Deallocates the given local; if it is already deallocated, this is
  a no-op. Not all local deallocations are explicit: if a non-return local is still live at
  function end (return or unwind), it is implicitly deallocated.
  If `--deallocate-all-locals` is set, all local deallocations are made explicit.
  -/
  | StorageDead (_0 : LocalId)
  /--
  A place is mentioned, but not accessed. The place itself must still be valid though, so
  this statement is not a no-op: it can trigger UB if the place's projections are not valid
  (e.g. because they go out of bounds).
  -/
  | PlaceMention (_0 : Place)
  /-- Statements that only affect borrow-checking. -/
  | Borrowck (_0 : BorrowckStatement)
  /--
  Drop the value at the given place.

  Depending on `DropKind`, this may be a real call to `drop_glue`, or a conditional call
  that should only happen if the place has not been moved out of. See the docs of `DropKind`
  for more details; to get precise drops use `--precise-drops`.

  Fields:
  - `place`
  - `fn_ptr`: Reference to the `drop_glue` code to call on drop.
  - `kind`
  - `on_unwind`
  -/
  | Drop (place : Place) (fn_ptr : FnPtr) (kind : DropKind) (on_unwind : Llbc.Block)
  /--
  Deallocate a `Box` whose pointee has already been moved out/dropped.

  Resugared when it appears in elaborated/optimized MIR, if `--treat-box-as-builtin` is set
  and `--desugar-drops` isn't.
  -/
  | DropEmptyBox (place : Place) (on_unwind : Llbc.Block)
  | Assert (assert : Assert) (on_failure : AbortKind) (on_unwind : Llbc.Block)
  /--
  An inline assembly block.

  Fields:
  - `asm`
  - `fallthrough`: Next block if the control-flow continues without jumping. Absent for `naked_asm!` and `noreturn`.
  - `labels`: Targets of [`AsmOperand::Label`] operands.
  - `on_unwind`: Action to be taken if the inline assembly unwinds.
  -/
  | InlineAsm (asm : InlineAsm) (fallthrough : Option Llbc.Block) (labels : IndexVec BranchId Llbc.Block) (on_unwind : Llbc.Block)
  | Call (call : Call) (dest : Place) (on_unwind : Llbc.Block)
  | Switch (data : SwitchData) (branches : IndexVec BranchId Llbc.Block)
  | Loop (_0 : Llbc.Block)
  /--
  Break out of one or more loops.
  The `usize` gives the index of the loop to break from, counting inside-out:
  * 0: break from the innermost loop (the current loop)
  * 1: break from the second innermost loop
  * ...
  -/
  | Break (_0 : Nat)
  /--
  Continue to the start of a loop.
  The `usize` gives the index of the loop to continue to, counting inside-out:
  * 0: continue to the start of the innermost loop (the current loop)
  * 1: continue to the start of the second innermost loop
  * ...
  -/
  | Continue (_0 : Nat)
  /--
  Call to a built-in panicking function. Only if `--reconstruct-panic-calls` is passed.

  Fields:
  - `name`: The name of the function that was called.
  - `on_unwind`
  -/
  | Panic (name : Name) (on_unwind : Llbc.Block)
  /-- Unwinding must stop for ABI reasons or because cleanup code panicked again. -/
  | UnwindTerminate
  /-- Unwind out of the current function into its caller. -/
  | UnwindResume
  | Return
  /-- Reaching this point is undefined behavior in the Rust abstract machine. -/
  | UndefinedBehavior
  /-- No-op. -/
  | Nop

end

deriving instance Inhabited for Llbc.Block
deriving instance Inhabited for Llbc.StatementKind
deriving instance Inhabited for Llbc.Statement

/-- A variable -/
structure Local where
  /-- Unique index identifying the variable -/
  index : LocalId
  /--
  Variable name - may be `None` if the variable was introduced by Rust
  through desugaring.
  -/
  name : Option String
  /-- Span of the variable declaration. -/
  span : Span
  /-- The variable type -/
  ty : Ty
  /-- Whether this local was declared `mut`. Anonymous locals are always mutable. -/
  mutable : Bool
  /-- If this local is a drop flag, this is the place whose initialization state it tracks. -/
  drop_flag_for : Option Place
  deriving Inhabited

/-- The local variables of a body. -/
structure Locals where
  /-- The number of local variables used for the input arguments. -/
  arg_count : Nat
  /--
  The local variables.
  We always have, in the following order:
  - the local used for the return value (index 0)
  - the `arg_count` input arguments
  - the remaining locals, used for the intermediate computations
  -/
  locals : IndexVec LocalId Local
  deriving Inhabited

/--
An expression body.
TODO: arg_count should be stored in GFunDecl below. But then,
      the print is obfuscated and Aeneas may need some refactoring.
-/
structure GExprBody (T : Type) where
  span : Span
  /--
  The number of regions existentially bound in this body. We introduce fresh such regions
  during translation instead of the erased regions that rustc gives us.
  -/
  bound_body_regions : Nat
  /-- The local variables. -/
  locals : Locals
  /-- The statements and blocks that compose this body. -/
  body : T
  /--
  For each line inside the body, we record any whole-line `//` comments found before it. They
  are added to statements in the late `recover_body_comments` pass.
  -/
  comments : Array (UInt32 × (Array String))
  deriving Inhabited

/-- Reference to a function declaration. -/
structure FunDeclRef where
  id : FunDeclId
  /-- Generic arguments passed to the function. -/
  generics : GenericArgs
  deriving Inhabited

/-- Common error used during the translation. -/
structure Error where
  span : Span
  msg : String
  deriving Inhabited

/--
The body of a function.

A normal function has a body that's either structured or unstructured. These are two equivalent
representations of the same function body, which only differ in how control-flow is
represented. By default bodies are structured; passing `--ullbc` to Charon makes bodies
unstructured.

Besides these, some functions have virtual bodies or no body, see the doc for each variant.
-/
inductive Body where
  /--
  Body represented as a control-flow graph (CFG), i.e. with numbered blocks and jumps/GOTOs
  between them. This is available when passing `--ullbc` to Charon.

  This is also the same structure as rustc's MIR, and is in fact a direct translation of it.
  -/
  | Unstructured (_0 : GExprBody (IndexVec Ullbc.BlockId Ullbc.BlockData))
  /--
  Body represented with structured control flow, i.e. with nested `if`/`match`/`loop` blocks.
  This is available when `--ullbc` is not passed to Charon.

  This structure is recovered from the unstructured body in the `ullbc_to_llbc` pass.
  -/
  | Structured (_0 : GExprBody Llbc.Block)
  /--
  A façade body that dispatches to one of several per-target function bodies. This is created
  during multi-target merging (using `--target`) to represent functions that have a different
  implementation across targets.
  -/
  | TargetDispatch (_0 : Array (String × FunDeclRef))
  /-- Function declared in an `extern { ... }` block. The string is the foreign symbol name. -/
  | Extern (_0 : String)
  /--
  Rust intrinsic function. This describes a "built-in" operation that must be handled by the
  codegen backend.

  Fields:
  - `name`: The intrinsic name.
  - `arg_names`: The argument names, None if not available.
  - `fallback`: A fallback body that backends can use if they don't implement the intrinsic themselves.
  - `fallback_is_spec`: Whether the fallback body is marked `#[miri::intrinsic_fallback_is_spec]`, in which case
  it exactly describes the behavior of the intrinsic. Otherwise the fallback is only one of
  the valid implementations of the intrinsic, e.g. the fallback may have less UB or less
  non-determinism.
  -/
  | Intrinsic (name : String) (arg_names : Array (Option String)) (fallback : Option FunDeclRef) (fallback_is_spec : Bool)
  /--
  A body that the user chose not to translate, based on opacity settings like
  `--include`/`--opaque`.
  -/
  | Opaque
  /--
  A body that was not available.

  These can occur when using a sysroot that doesn't have MIR for all the standard library
  functions. This is the case of the sysroot that ships with every Rust toolchain, but Charon
  uses a custom-built sysroot that does. So this shouldn't happen unless you're passing
  `--sysroot` to charon.
  -/
  | Missing
  /-- We encountered an error while translating this body. -/
  | Error (_0 : Error)
  deriving Inhabited

/--
An enum representing possible values for `cfg(target_abi)`.
This field is not forwarded to LLVM so it does not by itself affect codegen.
See the `cfg_abi` field of [`TargetOptions`] for more details.
-/
inductive CfgAbi where
  | Abi64
  | AbiV2
  | AbiV2Hf
  | Eabi
  | EabiHf
  | ElfV1
  | ElfV2
  | Fortanix
  | Ilp32
  | Ilp32e
  | Llvm
  | MacAbi
  | Pauthtest
  | Sim
  | SoftFloat
  | Spe
  | Uwp
  | VecDefault
  | VecExtAbi
  | X32
  | V8Plus
  | Unspecified
  /--
  The vast majority of the time, the compiler deals with a fixed
  set of values, so it is convenient for them to be represented in
  an enum. However, it is possible to have arbitrary values in a
  target JSON file (which can be parsed when `--target` is
  specified). This might occur, for example, for an out-of-tree
  codegen backend that supports a value (e.g. architecture or OS)
  that rustc currently doesn't know about. This variant exists as
  an escape hatch for such cases.
  -/
  | Other (_0 : String)
  deriving Inhabited

inductive SerializationFormatArg where
  | Json
  | Postcard
  | MiniRust
  | All
  deriving Inhabited

/--
Presets to make it easier to tweak options without breaking dependent projects. Eventually we
should define semantically-meaningful presets instead of project-specific ones.
-/
inductive Preset where
  /--
  The default translation used before May 2025. After that, many passes were made optional
  and disabled by default.
  -/
  | OldDefaults
  /--
  Emit the MIR as unmodified as possible. This is very imperfect for now, we should make more
  passes optional.
  -/
  | RawMir
  /-- Skip as many optional transformations as possible. -/
  | Fast
  | Aeneas
  | Eurydice
  | Soteria
  | Tests
  deriving Inhabited

inductive MonomorphizeMut where
  /-- Monomorphize any item instantiated with `&mut`. -/
  | All
  /-- Monomorphize all non-typedecl items instantiated with `&mut`. -/
  | ExceptTypes
  deriving Inhabited

/--
The MIR stage to use. This is only relevant for the current crate: for dependencies, only mir
optimized is available (or mir elaborated for consts).
-/
inductive MirLevel where
  /-- The MIR just after MIR lowering. -/
  | Built
  /-- The MIR after const promotion. This is the MIR used by the borrow-checker. -/
  | Promoted
  /--
  The MIR after drop elaboration. This is the first MIR to include all the runtime
  information.
  -/
  | Elaborated
  /--
  The MIR after optimizations. Charon disables all the optimizations it can, so this is
  sensibly the same MIR as the elaborated MIR.
  -/
  | Optimized
  deriving Inhabited

/-- How to handle constants and statics. -/
inductive ConstHandling where
  /--
  Keep consts as calls to their initializer with `ConstantExprKind::Call`, without attempting
  to do any const-evaluation. This is the default.
  -/
  | Initializers
  /--
  Try evaluating consts and statics to their final value. If evaluation fails, we fall back to the
  initializer call.
  -/
  | Values
  /--
  Try evaluating consts and statics to raw bytes, using `ConstantExprKind::RawMemory`. If
  evaluation fails, we fall back to the initializer call.
  -/
  | Bytes
  deriving Inhabited

structure CliOpts where
  /-- Extract the unstructured LLBC (i.e., don't reconstruct the control-flow) -/
  ullbc : Bool
  /--
  Reconstruct the control-flow without duplicating blocks: a block reachable from several
  branches is emitted once, and the branches `break` forward to it out of an enclosing
  `loop`. This can shrink bodies a lot, at the cost of control-flow that is harder to read.
  Note that consumers which expect `if`/`loop`-shaped bodies (e.g. aeneas) may not support
  the result.
  -/
  no_code_duplication : Bool
  /--
  Whether to precisely translate drops and drop-related code. For this, we add explicit
  `Destruct` bounds to all generic parameters and set the MIR level to at least `elaborated`.

  Without this option, drops may be "conditional" and we may lack information about what code
  is run on drop in a given polymorphic function body.
  -/
  precise_drops : Bool
  /--
  The MIR stage to extract. This is only relevant for the current crate; for dependencies only
  MIR optimized is available.
  -/
  mir : Option MirLevel
  /-- Extra flags to pass to rustc. -/
  rustc_args : Array String
  /--
  A list of target architectures to translate for. Charon will run the compiler once for each
  target and aggregate the results, which is useful if the code includes `#[cfg(..)]`
  filters.
  Warning: this is an initial implementation which is extremely slow.
  -/
  targets : Array String
  /--
  Sysroot to use for rustc invocations. By default Charon builds a sysroot that has full MIR
  for the standard library. You can pass a custom sysroot to use instead, or pass "default"
  to use the normal distributed sysroot, which lacks MIR bodies for many standard library
  functions.
  -/
  sysroot : Option String
  /--
  Monomorphize the items encountered when possible. Generic items found in the crate are
  skipped. To only translate a particular call graph, use `--start-from`. Note: this doesn't
  currently support `dyn Trait`.
  -/
  monomorphize : Bool
  /--
  Partially monomorphize items to make it so that no item is ever monomorphized with a
  mutable reference (or type containing one); said differently, so that the presence of
  mutable references in a type is independent of its generics. This is used by Aeneas.
  -/
  monomorphize_mut : Option MonomorphizeMut
  /--
  A list of item paths to use as starting points for the translation. We will translate these
  items and any items they refer to, according to the opacity rules. When absent, we start
  from the path `crate` (which translates the whole crate).
  -/
  start_from : Array String
  /--
  Same as --start-from, but won't raise an error if a pattern doesn't match any item. This is useful
  when the patterns are generated by a build script and may be out of sync with the code.
  -/
  start_from_if_exists : Array String
  /--
  Use all the items annotated with the given attribute(s) as starting points for translation
  (except modules).
  If an attribute name is not specified, `verify::start_from` is used.
  -/
  start_from_attribute : Array String
  /-- Use all the `pub` items as starting points for translation (except modules). -/
  start_from_pub : Bool
  /--
  Use global constructors as starting points for translation, i.e. the `#[used]` statics
  placed in the linker section that the target runs at startup (e.g. `.init_array` on ELF).
  -/
  start_from_global_ctors : Bool
  /-- Whitelist of items to translate. These use the name-matcher syntax. -/
  «include» : Array String
  /-- Blacklist of items to keep opaque. Works just like `--include`, see the doc there. -/
  «opaque» : Array String
  /-- Blacklist of items to not translate at all. Works just like `--include`, see the doc there. -/
  exclude : Array String
  /--
  Usually we skip the bodies of foreign methods and structs with private fields. When this
  flag is on, we don't.
  -/
  extract_opaque_bodies : Bool
  /--
  Usually we skip the provided methods that aren't used. When this flag is on, we translate
  them all.
  -/
  translate_all_methods : Bool
  /--
  Usually we only translate the vtables that are used in an unsizing coercion, and leave the
  `vtable` field of the other trait impls as `Lazy`. When this flag is on, we translate the
  vtable of every trait impl of a dyn-compatible trait.
  -/
  eager_vtables : Bool
  /--
  Whenever an impl doesn't implement a method (because it has a default body), this creates a
  duplicate method as if it had been implemented. This can simplify the call-graphs as
  otherwise calls within the default body would be indirected through trait proofs.
  -/
  duplicate_defaulted_methods : Bool
  /--
  Transform the associate types of traits to be type parameters instead. This takes a list
  of name patterns of the traits to transform, using the same syntax as `--include`.
  -/
  lift_associated_types : Array String
  /--
  Whether to hide various marker traits such as `Sized`, `Sync`, and `Send`
  anywhere they show up. This can considerably speed up translation.
  -/
  hide_marker_traits : Bool
  /-- Hide the `A` type parameter on standard library containers (`Box`, `Vec`, etc). -/
  hide_allocator : Bool
  /-- Don't translate doc comments. -/
  no_doc_comments : Bool
  /--
  Remove trait clauses that aren't ultimately used anywhere. This is potentially incorrect as
  sometimes the mere presence of a trait clause is used to justify an operation, e.g. copying
  `Copy` data using `unsafe`.
  -/
  remove_unused_clauses : Bool
  /--
  Trait method default bodies take a `Self: Trait` clause as parameter, so that they can be
  reused by multiple trait impls. This however causes trait definitions to be mutually
  recursive with their default methods. This flag removes `Self` clauses that aren't used to
  break this mutual recursion when possible.
  -/
  remove_unused_self_clauses : Bool
  /--
  Remove trait clauses from type declarations. Best combined with `--lift-associated-types`
  for type declarations that use trait associated types in their fields.
  -/
  remove_adt_clauses : Bool
  /-- Transform precise drops to the equivalent `drop_glue(&mut p)` call. -/
  desugar_drops : Bool
  /--
  Reconstruct conditional drops from the drop-flags and precise drops introduced by rustc's
  drop elaboration, when possible. This may leave drop flags if we couldn't identify a known
  pattern.
  -/
  resugar_drops : Bool
  /-- Detect the drop flags inserted by rustc, which are booleans that track initialedness of a place. -/
  detect_drop_flags : Bool
  /--
  Transform array-to-slice unsizing and repeat expressions into standard library function
  calls in LLBC.
  -/
  ops_to_function_calls : Bool
  /--
  Transform array/slice indexing into standard library function calls in LLBC. Note that this may
  introduce UB since it creates references that were not normally created, including when
  indexing behind a raw pointer.
  -/
  index_to_function_calls : Bool
  /-- Treat `Box<T>` as if it was a built-in type. -/
  treat_box_as_builtin : Bool
  /--
  Don't generate a type declaration per tuple arity. Instead, every tuple type refers to the
  single opaque declaration with id `TypeDeclId::UNIT`, and stores its field types in its
  generic arguments. This is meant for consumers that build tuples of arbitrary arity on the
  fly and don't care about their declaration. Note that this makes tuple types ill-typed with
  respect to their declaration; it is also incompatible with `--monomorphize`.
  -/
  no_gen_tuple_structs : Bool
  /-- Do not inline or evaluate constants. -/
  raw_consts : Bool
  /--
  Inline anonymous constants, including promoted constants and inline const blocks. This is
  unsound for promoted constants if they're used with a `'static` lifetime, as this will move
  the constant to a local variable.
  -/
  inline_anon_consts : Bool
  /--
  How to represent constants and statics: as a call to their initializer function, as an
  evaluated value, or as raw bytes. This is always best-effort: in some cases we only get the
  evaluated constant, and in others we cannot evaluate the constant and keep the initializer.
  -/
  consts : Option ConstHandling
  /--
  Replace "bound checks followed by UB-on-overflow operation" with the corresponding
  panic-on-overflow operation. This loses unwinding information.
  -/
  reconstruct_fallible_operations : Bool
  /-- Replace calls to built-in panic functions with a `Panic` terminator. -/
  reconstruct_panic_calls : Bool
  /-- Replace `if x { panic() }` with `assert(x)`. -/
  reconstruct_asserts : Bool
  /--
  Recombine a `read_discriminant(place)` followed by a `switch` into a single operation that
  uses enum variants instead of their discriminants.
  -/
  reconstruct_matches : Bool
  /--
  Ensure all local deallocations are made explicit with `StorageDead` statements. If this flag is not passed,
  every non-return local is implicitly deallocated on function return.
  Note this can add a lot of statements (quadratically-many, because of unwind paths).
  -/
  deallocate_all_locals : Bool
  /--
  Use `DeBruijnVar::Free` for the variables bound in item signatures, instead of
  `DeBruijnVar::Bound` everywhere. This simplifies the management of generics for projects
  that don't intend to manipulate them too much.
  -/
  unbind_item_vars : Bool
  /-- Pretty-print the ULLBC immediately after extraction from MIR. -/
  print_original_ullbc : Bool
  /-- Pretty-print the ULLBC after applying the micro-passes (before serialization/control-flow reconstruction). -/
  print_ullbc : Bool
  /-- Pretty-print the LLBC just after we built it (i.e., immediately after loop reconstruction). -/
  print_built_llbc : Bool
  /-- Pretty-print the final LLBC (after all the cleaning micro-passes). -/
  print_llbc : Bool
  /-- When pretty-printing, also print the layout of every type declaration. -/
  print_layouts : Bool
  /-- When pretty-printing, add comments that indicate which items and statements are unsafe. -/
  print_safety : Bool
  /--
  The destination directory. Files will be generated as
  `<dest_dir>/<crate_name>.{u}llbc` for json and `<dest_dir>/<crate_name>.{u}llbc.postcard`
  for postcard, unless `dest_file` is set. `dest_dir` defaults to the current directory.
  -/
  dest_dir : Option String
  /--
  The destination file. By default this depends on `format` and `ullbc`. If this is set we
  ignore `dest_dir`. If used with `format=all`, will add an extension corresponding to the file format
  at the end of the provided file name.
  -/
  dest_file : Option String
  /-- Don't deduplicate values (types, trait refs) in the .(u)llbc file. This makes the file easier to inspect. -/
  no_dedup_serialized_ast : Bool
  /-- Serialization format for emitted files. Defaults to json. -/
  format : Option SerializationFormatArg
  /-- Run the translated program with MiniRust. -/
  run_with_minirust : Bool
  /-- Don't serialize the final (U)LLBC to a file. -/
  no_serialize : Bool
  /-- If activated, this skips borrow-checking of the crate. -/
  skip_borrowck : Bool
  /-- Don't generate distinct `Region::Body` lifetimes inside function bodies; use `Region::Erased` instead. -/
  erase_body_lifetimes : Bool
  /-- Skip the typecheck passes. -/
  no_typecheck : Bool
  /-- Don't normalize associated types. -/
  no_normalize : Bool
  /-- Don't compute a stable order for declarations. -/
  no_reorder_decls : Bool
  /-- Don't compute type layout guarantees. -/
  no_compute_layout_guarantees : Bool
  /-- Panic on the first error. This is useful for debugging. -/
  abort_on_error : Bool
  /-- Consider any warnings to be errors. -/
  error_on_warnings : Bool
  /-- Named builtin sets of options. -/
  preset : Option Preset
  deriving Inhabited

inductive ClosureKind where
  | Fn
  | FnMut
  | FnOnce
  deriving Inhabited

/-- Additional information for closures. -/
structure ClosureInfo where
  kind : ClosureKind
  /-- The `FnFoo::call` method that contains the closure body. -/
  closure_body : FunDeclRef
  /-- The `FnOnce` implementation of this closure -- always exists. -/
  fn_once_impl : RegionBinder TraitImplRef
  /-- The `FnMut` implementation of this closure, if any. -/
  fn_mut_impl : Option (RegionBinder TraitImplRef)
  /-- The `Fn` implementation of this closure, if any. -/
  fn_impl : Option (RegionBinder TraitImplRef)
  /-- The signature of the function that this closure represents. -/
  signature : RegionBinder FunSig
  deriving Inhabited

/--
A (group of) top-level declaration(s), properly reordered.
"G" stands for "generic"
-/
inductive GDeclarationGroup (Id : Type) where
  /-- A non-recursive declaration -/
  | NonRec (_0 : Id)
  /-- A (group of mutually) recursive declaration(s) -/
  | Rec (_0 : Array Id)
  deriving Inhabited

/-- A (group of) top-level declaration(s), properly reordered. -/
inductive DeclarationGroup where
  /-- A type declaration group -/
  | «Type» (_0 : GDeclarationGroup TypeDeclId)
  /-- A function declaration group -/
  | Fun (_0 : GDeclarationGroup FunDeclId)
  /-- A global declaration group -/
  | Global (_0 : GDeclarationGroup GlobalDeclId)
  | TraitDecl (_0 : GDeclarationGroup TraitDeclId)
  | TraitImpl (_0 : GDeclarationGroup TraitImplId)
  /-- Anything that doesn't fit into these categories. -/
  | Mixed (_0 : GDeclarationGroup ItemId)
  deriving Inhabited

/-- Layout information given by the metadata of an unsized type. -/
inductive MetadataValue where
  /-- For a DST with `dyn Trait` metadata, this refers to the size found in the metadata. -/
  | DynSize
  /-- For a DST with `dyn Trait` metadata, this refers to the alignment found in the metadata. -/
  | DynAlign
  /-- For a DST with slice metadata, this refers to the length found in the metadata. -/
  | SliceLength
  deriving Inhabited

mutual

inductive SizeExprKind where
  /-- An arbitrary constant of type `usize`. -/
  | Constant (_0 : ConstantExpr)
  /-- Layout information stored in the pointer metadata to this object. -/
  | FromMetadata (_0 : MetadataValue)
  | Max (_0 : Array SizeExprKind)
  | Min (_0 : Array SizeExprKind)
  | Plus (_0 : SizeExprKind) (_1 : SizeExprKind)
  /-- Multiply by a constant. -/
  | Scale (_0 : SizeExprKind) (_1 : ConstantExpr)
  /-- The size is at least the value of this expression. -/
  | AtLeast (_0 : SizeExprKind)
  /-- The next multiple of `target_align` from `base`. -/
  | AlignTo (base : SizeExprKind) (target_align : SizeExprKind)
  /-- A size expression that depens on whether the given type is inhabited. -/
  | IfInhabited (ty : Ty) (then_size : SizeExprKind) (else_size : SizeExprKind)

end

deriving instance Inhabited for SizeExprKind

/-- An expression that represents a size in bytes. -/
abbrev SizeExpr := SizeExprKind

/-- The predecessor of a field in a struct or enum variant. -/
inductive FieldPredecessor where
  | Field (_0 : FieldId)
  | Tag
  deriving Inhabited

/-- Guaranteed facts about a field offset. -/
inductive OffsetGuarantee where
  /-- Guaranteed to be exactly at the given offset. -/
  | AtOffset (_0 : SizeExpr)
  /-- Guaranteed only to be aligned to the given expression. -/
  | GuaranteedAlignment (_0 : SizeExpr)
  /--
  This offset is computed by the layout algorithm for C: take the previous field offset, add
  the previous field size, and align to the current field alignment (as capped by `packed`).
  -/
  | ReprCField (_0 : FieldPredecessor)
  deriving Inhabited

/-- An expression denoting an offset in bytes. -/
structure OffsetExpr where
  /-- The guarantees about this offset that can be relied on according to the Rust Reference. -/
  guarantee : Option OffsetGuarantee
  /-- The offset chosen by this rustc run. `None` for unsized fields. -/
  chosen : Option UInt64
  deriving Inhabited

mutual

/--
Decision tree used to determine the active variant by reading memory. Mirrors MiniRust's
`Discriminator`.
-/
inductive Discriminator where
  /-- The variant is known. -/
  | Known (_0 : VariantId)
  /-- No valid variant (e.g., invalid tag value). -/
  | Invalid
  /--
  Branch on an integer value read from memory at `offset`.

  Fields:
  - `offset`: Byte offset to read from.
  - `int_ty`: Integer type to read.
  - `children`: If the integer is in one of these ranges, continue with the given `Discriminator`. The
  ranges are sorted.
  - `fallback`: Fallback if no range in `children` matches.
  -/
  | Branch (offset : OffsetExpr) (int_ty : IntegerTy) (children : Array ((RangeInclusive IntegerValue) × Discriminator)) (fallback : Discriminator)

end

deriving instance Inhabited for Discriminator

inductive Env where
  | Gnu
  | MacAbi
  | Mlibc
  | Msvc
  | Musl
  | Newlib
  | Nto70
  | Nto71
  | Nto71IoSock
  | Ohos
  | Relibc
  | Sgx
  | Sim
  | P1
  | P2
  | P3
  | Uclibc
  | V5
  | Unspecified
  /--
  The vast majority of the time, the compiler deals with a fixed
  set of values, so it is convenient for them to be represented in
  an enum. However, it is possible to have arbitrary values in a
  target JSON file (which can be parsed when `--target` is
  specified). This might occur, for example, for an out-of-tree
  codegen backend that supports a value (e.g. architecture or OS)
  that rustc currently doesn't know about. This variant exists as
  an escape hatch for such cases.
  -/
  | Other (_0 : String)
  deriving Inhabited

structure Field where
  span : Span
  attr_info : AttrInfo
  name : String
  /--
  Whether this field is positional, as in a tuple struct, tuple variant, or closure. If so,
  its name is based on its position, such as `_0`; otherwise, it is a user-provided name.
  -/
  is_positional : Bool
  ty : Ty
  deriving Inhabited

/-- A filename. -/
inductive FileName where
  /-- A remapped path (namely paths into stdlib) -/
  | Virtual (_0 : String)
  /-- A local path (a file coming from the current crate for instance) -/
  | Local (_0 : String)
  /-- A "not real" file name (macro, query, etc.) -/
  | NotReal (_0 : String)
  deriving Inhabited

structure File where
  /-- The file identifier. -/
  id : FileId
  /-- The path to the file. -/
  name : FileName
  /-- Name of the crate this file comes from. -/
  crate_name : String
  /--
  The contents of the source file, as seen by rustc at the time of translation.
  Some files don't have contents.
  -/
  contents : Option String
  deriving Inhabited

