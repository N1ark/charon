  | Projection (_0 : GlobalPlace) (_1 : ConstProjectionElem)

/--
Provenance is the location in memory a pointer (or the byte of a pointer, see [`Byte`])
points to. `GlobalProvenance` represents a compile-time provenance.
See <https://doc.rust-lang.org/std/ptr/index.html#provenance>
-/
inductive GlobalProvenance where
  | Global (_0 : GlobalDeclRef)
  /-- A function, with the type of function pointers to it. -/
  | Function (_0 : FnPtr) (_1 : TyKind)
  /--
  The allocation backing the `TypeId` of this type. Note that `TypeId`s always have 16 bytes
  worth of provenance, regardless of the platform's pointer size, so [`Byte::Provenance`]'s byte index can
  go up to 16! In other words, the bytes of a full `TypeId` are `Provenance(TypeId(ty), 0, 0..16)`.
  -/
  | TypeId (_0 : TyKind)

/--
The predicate that the left region outlives the right region, i.e. `'l: 'r`. The left one is
longer, and also contains fewer loans.

This can also represent `T: 'r`, by using `Region::Lub` for the left region. The right region
may not be `Region::Lub`.
-/
structure OutlivesPred where
  _0 : Region
  _1 : Region

/--
A value of type `T` bound by regions. We should use `binder` instead but this causes name clash
issues in the derived ocaml visitors.

This is a copy of `RegionBinder` specialized to the arguments `OutlivesPred`, because Lean doesn't support polymorphic recursion.
-/
structure PolyOutlivesPred where
  regions : IndexVec RegionId RegionParam
  /-- Outlives relations involving the bound regions. -/
  outlives : Array PolyOutlivesPred
  /--
  Named this way to highlight accesses to the inner value that might be handling parameters
  incorrectly. Prefer using helper methods.
  -/
  skip_binder : OutlivesPred

inductive Region where
  /-- Region variable. See `DeBruijnVar` for details. -/
  | Var (_0 : DeBruijnVar RegionId)
  /--
  The least upper bound, in the outlives ordering, of the regions in this type.
  `'lub<T>: 'a` is equivalent to `T: 'a`.
  -/
  | Lub (_0 : TyKind)
  /-- Static region -/
  | Static
  /-- Body-local region, considered existentially-bound at the level of a body. -/
  | Body (_0 : RegionId)
  /-- Erased region -/
  | Erased

/-- Region arguments used to instantiate a [`RegionBinder`]. -/
structure RegionArgs where
  regions : IndexVec RegionId Region

/-- The value of a trait associated type. -/
structure TraitAssocTyImpl where
  value : TyKind
  /--
  This matches the corresponding vector in `TraitAssocTy`. In the same way, this is empty
  after the `lift_associated_item_clauses` pass.
  -/
  implied_trait_refs : IndexVec TraitClauseId (RegionBinder.Gen PolyOutlivesPred TraitRefContents)

/--
A predicate of the form `Type: Trait<Args>`.

About the generics, if we write:
```text
impl Foo<bool> for String { ... }
```

The substitution is: `[String, bool]`.
-/
structure TraitDeclRef where
  id : TraitDeclId
  generics : GenericArgs

/-- A reference to a tait impl, using the provided arguments. -/
structure TraitImplRef where
  id : TraitImplId
  generics : GenericArgs

/--
A trait predicate in a signature, of the form `Type: Trait<Args>`. This functions like a
variable binder, to which variables of the form `TraitRefKind::Clause` can refer to.
-/
structure TraitParam where
  /-- Index identifying the clause among other clauses bound at the same level. -/
  clause_id : TraitClauseId
  span : Option Span
  /-- Where the predicate was written, relative to the item that requires it. -/
  origin : PredicateOrigin
  /-- The trait that is implemented. -/
  trait_ : RegionBinder.Gen PolyOutlivesPred TraitDeclRef

structure TraitRefContents where
  kind : TraitRefKind
  /-- The predicate that is proven by that trait proof. -/
  trait_decl_ref : TraitDeclRef

/--
Identifier of a trait instance.
This is derived from the trait resolution.

Should be read as a path inside the trait clauses which apply to the current
definition. Note that every path designated by `TraitInstanceId` refers
to a *trait instance*, which is why the [`TraitRefKind::Clause`] variant may seem redundant
with some of the other variants.
-/
inductive TraitRefKind where
  /-- A specific top-level implementation item. -/
  | TraitImpl (_0 : TraitImplRef)
  /--
  One of the local clauses, instantiated with the given region arguments.

  Example:
  ```text
  fn f<T>(...) where T : Foo
                     ^^^^^^^
                     Clause(0)
  ```
  -/
  | Clause (_0 : DeBruijnVar TraitClauseId) (_1 : RegionArgs)
  /--
  A parent clause

  Example:
  ```text
  trait Foo1 {}
  trait Foo2 { fn f(); }

  trait Bar : Foo1 + Foo2 {}
              ^^^^   ^^^^
                     parent clause 1
      parent clause 0

  fn g<T : Bar>(x : T) {
    x.f()
    ^^^^^
    Parent(Clause(0), 1)::f(x)
                      ^
                      parent clause 1 of clause 0
  }
  ```
  -/
  | ParentClause (_0 : TraitRefContents) (_1 : TraitClauseId) (_2 : RegionArgs)
  /--
  A clause defined on an associated type.

  Example:
  ```text
  trait Foo {
    type W<X>: Bar0 + Bar1 // Bar1 contains a method bar1
                      ^^^^
                this is the clause 1 applying to W
  }

  fn f<T: Foo>(x : T::W<u32>) {
    x.bar1();
    ^^^^^^
    ItemClause {
        trait_ref: Clause(0), // start with the `T: Foo` clause
        type_id: W, // look at the item `W`
        generics: [u32], // with these args
        clause_id: 1, // and take the clause 1 of this item
        clause_args: [],
    }
  }
  ```

  For associated types without arguments, we turn such clauses into parent clauses of the
  trait, in the `lift_associated_item_clauses` pass.

  Fields:
  - `trait_ref`
  - `type_id`
  - `generics`: Generic arguments for the associated type.
  - `clause_id`: Id of the clause among those for this item.
  - `clause_args`: Region arguments that instantiate the higher-ranked item clause.
  -/
  | ItemClause (trait_ref : TraitRefContents) (type_id : AssocTypeId) (generics : GenericArgs) (clause_id : TraitClauseId) (clause_args : RegionArgs)
  /--
  The implicit `Self: Trait` clause. Present inside trait declarations, including trait
  method declarations. Not present in trait implementations as we can use `TraitImpl` intead.
  -/
  | SelfId
  /--
  A trait implementation that is computed by the compiler, such as for built-in trait
  `Sized`. This morally points to an invisible `impl` block; as such it contains
  the information we may need from one.

  Also used as a placeholder for trait clauses that were stripped by the
  `--remove-adt-clauses` pass: the original `Clause` reference is replaced with a
  `BuiltinOrAuto { builtin_data: RemovedAdtClause, .. }`. See
  [`BuiltinImplData::RemovedAdtClause`].

  Fields:
  - `builtin_data`: Metadata that identifies this impl.
  - `parent_trait_refs`: Exactly like the same field on `TraitImpl`: the `TraitRef`s required to satisfy the
  implied predicates on the trait declaration. E.g. since `FnMut: FnOnce`, a built-in `T:
  FnMut` impl would have a `TraitRef` for `T: FnOnce`.
  - `types`: The values of the associated types for this trait.
  - `vtable`: The vtable value for this builtin implementation, if we generated one.
  -/
  | BuiltinOrAuto (builtin_data : BuiltinImplData) (parent_trait_refs : IndexVec TraitClauseId (RegionBinder.Gen PolyOutlivesPred TraitRefContents)) (types : IndexMap AssocTypeId TraitAssocTyImpl) (vtable : Option GlobalDeclRef)
  /-- The automatically-generated implementation for `dyn Trait`. -/
  | Dyn
  /-- For error reporting. -/
  | Unknown (_0 : String)

/--
A constraint over a trait associated type.

Example:
```text
T : Foo<S = String>
        ^^^^^^^^^^
```
-/
structure TraitTypeConstraint where
  trait_ref : TraitRefContents
  type_id : AssocTypeId
  ty : TyKind

/--
A type.

This is interned as `Ty`, making it cheap to clone and compare.
-/
inductive TyKind where
  /-- A scalar (integers, floats, `char`, or `bool`). -/
  | Scalar (_0 : ScalarTy)
  /--
  An array `[T; N]`. The third field is the proof that `T: Sized`; it is absent with
  `--hide-marker-traits`.
  -/
  | Array (_0 : TyKind) (_1 : ConstantExpr) (_2 : Option TraitRefContents)
  /--
  A slice `[T]`. The second field is the proof that `T: Sized`; it is absent with
  `--hide-marker-traits`.
  -/
  | Slice (_0 : TyKind) (_1 : Option TraitRefContents)
  /-- An ADT: structs, enums, unions, as well as tuples and `str`. -/
  | Adt (_0 : TypeDeclRef)
  /-- A reference: `&T` or `&mut T`. -/
  | Ref (_0 : Region) (_1 : TyKind) (_2 : RefKind)
  /-- A raw pointer. -/
  | RawPtr (_0 : TyKind) (_1 : RefKind)
  /--
  The unique type associated with each function item. Each function item is given a unique
  type that has the function's early-bound generics. This type is not generally nameable in
  Rust; it's a ZST (there's a unique value), and a value of that type can be cast to a
  function pointer or passed to functions that expect `FnOnce`/`FnMut`/`Fn` parameters.

  There's a binder here because charon function items take both early and late-bound
  lifetimes as arguments; given that the type we're pointing to is polymorphic in the
  late-bound variables, we need to bind them here.

  ```rust
  // `'a` is early-bound, 'b is late-bound.
  fn foo<'a, 'b>(x: &'a u32, y: &'b u32)
  where u32: 'b
  {}
  ```
  For rustc, there's a ZST `foo<'a>`, that can be cast to a `for<'b> fn(&'a u32, &'b u32)`
  function pointer.
  For charon, there's an item `foo<'a, 'b>`, and the `FnDef` item that corresponds to rustc's
  `foo<'a>` is represented as `FnDef(for<'b> foo<'a, 'b>)`.
  -/
  | FnDef (_0 : RegionBinder.Gen PolyOutlivesPred FnPtr)
  /--
  Function pointer type. This is a literal pointer to a region of memory that contains a
  callable function.

  A function pointer can have lifetime generics, e.g. `for<'a> fn(&'a mut u32) -> &'a u32`,
  hence the binder.
  -/
  | FnPtr (_0 : RegionBinder.Gen PolyOutlivesPred FunSig)
  /--
  `dyn Trait`: erased value known to implement `Trait`. A pointer to it will carry a vtable
  pointer that stores the methods that can be called on this value.
  -/
  | DynTrait (_0 : DynPredicate)
  /--
  A pattern type: a type that is representationally identical to its base type, except the
  only valid values are the ones that match the pattern.
  -/
  | Pattern (_0 : TyKind) (_1 : TypePattern)
  /-- The never type, the canonical uninhabited type. -/
  | Never
  /-- A type variable. -/
  | TypeVar (_0 : DeBruijnVar TypeVarId)
  /-- A trait associated type: `<T as Trait>::AssocType<Args>`. -/
  | TraitType (_0 : TraitRefContents) (_1 : AssocTypeId) (_2 : GenericArgs)
  /--
  The type of pointer metadata for the given type; e.g. for `[T]`, this type is `usize`. The
  way to write this type in Rust is `<X as core::ptr::Pointee>::Metadata`.
  -/
  | PtrMetadata (_0 : TyKind)
  /-- A type that could not be computed or was incorrect. -/
  | Error (_0 : String)

/--
Reference to a type declaration.

This includes user-defined ADTs (structs, enums, unions), but also tuples,
boxes, and `str`, which we translate as `struct str([u8])`.
-/
structure TypeDeclRef where
  id : TypeDeclId
  generics : GenericArgs
  /-- If this points to a builtin ADT, it is recorded here for easier identification. -/
  builtin : Option BuiltinAdt

/-- A type-level pattern used by [`TyKind::Pattern`]. -/
inductive TypePattern where
  | Range (_0 : ConstantExpr) (_1 : ConstantExpr)
  | OrPattern (_0 : Array TypePattern)
  | NotNull

inductive UnsizingMetadata where
  /-- Cast from `[T; N]` to `[T]`. -/
  | Length (_0 : ConstantExpr)
  /--
  Cast from a sized value to a `dyn Trait` value. The `TraitRef` is the proof of the `dyn
  Trait` predicate; the constant expression is a reference to the vtable `static` value.
  -/
  | VTable (_0 : RegionBinder.Gen PolyOutlivesPred TraitRefContents) (_1 : ConstantExpr)
  /--
  Cast from `dyn Trait` to `dyn OtherTrait`. The fields indicate how to retreive the vtable:
  it's always either the same we already had, or the vtable for a (possibly nested) supertrait.

  Note that we cheat in one case: when upcasting to a marker trait (e.g. `dyn Trait -> dyn
  Sized`), we keep the current vtable.
  -/
  | VTableUpcast (_0 : Array FieldId)
  | Unknown

end

