/-- How much to translate for a given item. -/
inductive ItemOpacity where
  /-- Translate the item fully. -/
  | Transparent
  /--
  Translate the item depending on the normal rust visibility of its contents: for types, we
  translate fully if it is a struct with public fields or an enum; for other items this is
  equivalent to `Opaque`.
  -/
  | Foreign
  /--
  Translate the item name and signature, but not its contents. For function and globals, this
  means we don't translate the body (the code); for ADTs, this means we don't translate the
  fields/variants. For traits and trait impls, this doesn't change anything. For modules,
  this means we don't explore its contents (we still translate any of its items mentioned
  from somewhere else).

  This can happen either if the item was annotated with `#[charon::opaque]` or if it was
  declared opaque via a command-line argument.
  -/
  | Opaque
  /--
  Translate nothing of this item. The corresponding map will not have an entry for the
  `ItemId`. Useful when even the signature of the item causes errors.
  -/
  | Invisible
  deriving Inhabited

/-- Meta information about an item (function, trait decl, trait impl, type decl, global). -/
structure ItemMeta where
  name : Name
  span : Span
  /-- The source code that corresponds to this item. -/
  source_text : Option String
  /-- Attributes and visibility. -/
  attr_info : AttrInfo
  /-- `true` if the type decl is a local type decl, `false` if it comes from an external crate. -/
  is_local : Bool
  /--
  Whether this item was selected as a starting point for translation (using `--start-from`,
  or by default the main crate), or contained in one.
  -/
  started_from : Bool
  /-- Whether this item is declared in an `extern { .. }` block. -/
  is_extern : Bool
  /--
  Whether this item is considered opaque. For function and globals, this means we don't
  translate the body (the code); for ADTs, this means we don't translate the fields/variants.
  For traits and trait impls, this doesn't change anything. For modules, this means we don't
  explore its contents (we still translate any of its items mentioned from somewhere else).

  This can happen either if the item was annotated with `#[charon::opaque]` or if it was
  declared opaque via a command-line argument.
  -/
  opacity : ItemOpacity
  /-- If the item is a rustc lang item, record which one it is. -/
  lang_item : Option LangItem
  /-- If the item is a rustc diagnostic item, record its internal identifier. -/
  diagnostic_item : Option String
  /-- Whether an error occurred while translating this item. -/
  has_errors : Bool
  deriving Inhabited

/-- Where a given function came from. -/
inductive FunSource where
  /-- A normal function. -/
  | Normal
  /-- A synthetic function representing an ADT constructor. -/
  | AdtConstructor
  /--
  A method in an inherent implementation.

  Fields:
  - `self_ty`: The self type of the impl block.
  -/
  | InherentImpl (self_ty : Ty)
  /--
  A default method in a trait declaration.

  Fields:
  - `trait_ref`: The trait declaration this item belongs to.
  - `item_id`: The method this corresponds to.
  -/
  | TraitDefault (trait_ref : TraitDeclRef) (item_id : TraitMethodId)
  /--
  A method in a trait implementation.

  Fields:
  - `impl_ref`: The trait implementation the method belongs to.
  - `trait_ref`: The trait declaration that the impl block implements.
  - `item_id`: The method this corresponds to.
  - `reuses_default`: True if the trait decl had a default implementation for this method and this item is a
  copy of the default item.
  -/
  | TraitImpl (impl_ref : TraitImplRef) (trait_ref : TraitDeclRef) (item_id : TraitMethodId) (reuses_default : Bool)
  /--
  Wraps a concrete implementation of a method into a function that takes `dyn Trait` as its
  `Self` type. This shim casts the receiver to the known concrete type and calls the real
  method.
  -/
  | VTableShim
  /-- The initializer for a global. -/
  | GlobalInitializer (_0 : GlobalDeclRef)
  /--
  A target-specific variant behind a `TargetDispatch` façade. The dispatcher is the function
  with the `Body::TargetDispatch` body that dispatches to this function.
  -/
  | TargetDependent (dispatcher : FunDeclRef)
  deriving Inhabited

/-- A function definition -/
structure FunDecl where
  def_id : FunDeclId
  /-- The meta data associated with the declaration. -/
  item_meta : ItemMeta
  generics : GenericParams
  /-- The signature contains the inputs/output types and ABI details. -/
  signature : FunSig
  /-- The function kind: "regular" function, trait method declaration, etc. -/
  src : FunSource
  /-- The function body. -/
  body : Body
  deriving Inhabited

/-- An expression denoting a size in bytes. -/
structure Size where
  /--
  The size chosen by this rustc run. For sized types, this is a plain integer, and for unsized
  types, this is an expression describing how to compute this size based on the values found
  in the pointer metadata. This can be `None` for polymorphic types.
  -/
  chosen : Option SizeExpr
  /-- The guarantees about this size that can be relied on according to the Rust Reference. -/
  guarantee : Option SizeExpr
  deriving Inhabited

/-- Where a given global came from. -/
inductive GlobalSource where
  /-- A normal global. -/
  | Normal
  /--
  A default assoc const in a trait declaration.

  Fields:
  - `trait_ref`: The trait declaration the const belongs to.
  - `item_id`: The associated const this corresponds to.
  -/
  | TraitDefault (trait_ref : TraitDeclRef) (item_id : AssocConstId)
  /--
  An associated const in a trait implementation.

  Fields:
  - `impl_ref`: The trait implementation the const belongs to.
  - `trait_ref`: The trait declaration that the impl block implements.
  - `item_id`: The associated const this corresponds to.
  - `reuses_default`: True if the trait decl had a default value for this const and this item is a copy of
  the default item.
  -/
  | TraitImpl (impl_ref : TraitImplRef) (trait_ref : TraitDeclRef) (item_id : AssocConstId) (reuses_default : Bool)
  /--
  Defines the vtable for a trait impl.

  Fields:
  - `self_ty`: The concrete type this vtable is for.
  - `impl_ref`: The originating impl. This is `None` in monomorphized mode: the vtable global itself
  identifies the concrete instantiation, so we don't translate an impl reference solely
  to record its provenance.
  -/
  | VTableInstance (self_ty : Ty) (impl_ref : Option TraitImplRef)
  deriving Inhabited

inductive GlobalKind where
  /--
  A static or thread-local static.

  Fields:
  - `is_mut`
  - `is_safe`: `false` for statics declared in an `extern` block without the `safe` qualifier.
  - `is_thread_local`: `true` for thread-local statics (through `thread_local!` or `#[thread_local]`).
  -/
  | Static (is_mut : Bool) (is_safe : Bool) (is_thread_local : Bool)
  /-- A const with a name (either top-level or an associated const in a trait). -/
  | NamedConst
  /--
  A const without a name:
  - An inline const expression (`const { 1 + 1 }`);
  - A const expression in a type (`[u8; sizeof::<T>()]`);
  - A promoted constant, automatically lifted from a body (`&0`).
  -/
  | AnonConst
  /--
  The VTable of a trait implementation. Such globals can only be accessed by the generated
  code -- it is UB to access them from user code.
  -/
  | VTable
  deriving Inhabited

/-- A global variable definition (constant or static). -/
structure GlobalDecl where
  def_id : GlobalDeclId
  /-- The meta data associated with the declaration. -/
  item_meta : ItemMeta
  /--
  Remark: constants can actually have generic parameters.
  ```text
  struct V<const N: usize, T> {
      x: [T; N],
  }

  impl<const N: usize, T> V<N, T> {
      const LEN: usize = N; // This has generics <N, T>
  }

  fn use_v<const N: usize, T>(v: V<N, T>) {
      let l = V::<N, T>::LEN; // We need to provided a substitution here
  }
  ```
  -/
  generics : GenericParams
  ty : Ty
  /-- The size in bytes of the global's allocation. -/
  size : Size
  /-- The alignment in bytes of the global's allocation. -/
  align : Size
  /-- The pointer metadata for references to this global (needed for unsized globals). -/
  ptr_metadata : ConstantExpr
  /--
  The context of the global: distinguishes normal items from trait-associated items and
  vtable instances.
  -/
  src : GlobalSource
  /-- The kind of global (static or const). -/
  global_kind : GlobalKind
  /--
  The value of this constant/static. By default this is a [`ConstantExprKind::Call`] to the
  initializer function that computes the value (the function uses the same generic parameters
  as the global).
  -/
  value : ConstantExpr
  deriving Inhabited

/-- Which marker traits this type implements. -/
structure ImplementsMarkerTraits where
  is_sized : Bool
  is_send : Bool
  is_sync : Bool
  is_freeze : Bool
  is_unpin : Bool
  deriving Inhabited

mutual

inductive InhabitedPredicateKind where
  | True
  | False
  /-- Inhabited when this constant is zero. -/
  | ConstIsZero (_0 : ConstantExpr)
  /-- Inhabited when this generic type is inhabited. -/
  | GenericType (_0 : Ty)
  | And (_0 : Array InhabitedPredicateKind)
  | Or (_0 : Array InhabitedPredicateKind)

end

deriving instance Inhabited for InhabitedPredicateKind

/--
Represents whether a type or variant is inhabited. Like rustc's `InhabitedPredicate`, this can
depend on generic parameters and constant values.
-/
abbrev InhabitedPredicate := InhabitedPredicateKind

/--
Simplified layout of a single variant.

Maps fields to their offset within the layout.
-/
structure VariantLayout where
  /-- The offset of each field. -/
  field_offsets : IndexVec FieldId OffsetExpr
  /--
  Whether the variant has any valid possible value.
  Note that uninhabited types can have arbitrary layouts.
  -/
  inhabited : InhabitedPredicate
  /--
  How to write the tag when constructing this variant. Each entry means: write `value` at
  byte `offset`. Mirrors MiniRust's `Variant::tagger`.
  -/
  tagger : Array (UInt64 × IntegerValue)
  deriving Inhabited

/--
Describes which layout algorithm is used for representing the corresponding type.
Depends on the `#[repr(...)]` used.
-/
inductive ReprAlgorithm where
  /-- The default layout algorithm. Used without an explicit `ŗepr` or for `repr(Rust)`. -/
  | Rust
  /-- The C layout algorithm as enforced by `repr(C)`. -/
  | C
  /-- The SIMD vector layout algorithm as enforced by the unstable `repr(simd)`. -/
  | Simd
  deriving Inhabited

/--
The representation options as annotated by the user.

NOTE: This does not include the compiler internal `#[repr(linear)]`. Similarly, enum
discriminant representations are encoded in [`Variant::discriminant`] and [`Discriminator`]
instead.
-/
structure ReprOptions where
  repr_algo : ReprAlgorithm
  align_modif : Option AlignmentModifier
  transparent : Bool
  /-- The type supplied to `repr(..)`, if any. -/
  explicit_discr_type : Option IntegerTy
  deriving Inhabited

/--
Type layout information.

Does not include information about niches.
If the type does not have a fully known layout (e.g. it is ?Sized)
some of the layout parts are not available.
-/
structure Layout where
  /-- The size of the type in bytes. -/
  size : Size
  /-- The alignment, in bytes. -/
  align : Size
  /-- Decision tree that determines the active variant by reading memory. Only `Some` for enums. -/
  discriminator : Option Discriminator
  /--
  Whether the type has any valid value.
  Note that uninhabited types can have arbitrary layouts: `(u32, !)` has space for the `u32`
  and `enum E2 { A, B(!), C(i32, !) }` may have space for a discriminant.
  -/
  inhabited : InhabitedPredicate
  /--
  Map from `VariantId` to the corresponding field layouts. Some variants don't have a
  meaningful layout due to being uninhabited (though an uninhabited variant may have a
  layout). Structs and unions are modeled as having exactly one variant.
  -/
  variant_layouts : IndexVec VariantId (Option VariantLayout)
  /--
  For unions: the `(offset, size)` ranges of bytes that aren't padding, i.e. that are data in
  at least one field. The other bytes are lost on a typed copy. `None` for non-unions and when
  the layout isn't known.
  -/
  union_chunks : Option (Array (UInt64 × UInt64))
  /-- The representation options of this type declaration as annotated by the user. -/
  repr : ReprOptions
  deriving Inhabited

